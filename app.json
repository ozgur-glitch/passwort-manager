{
  "expo": {
    "name": "Password Manager",
    "slug": "passwort-manager",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121824"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ceozsteam.passwortmanager",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Diese App benötigt Face ID, um den Tresor sicher zu entsperren."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#121824"
      },
      "package": "com.ceozsteam.passwortmanager"
    },
    "web": {
      "favicon": "./favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Erlaube $(PRODUCT_NAME) die Verwendung von Face ID zur Entsperrung."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ed0e3dcb-2dd1-4603-8c27-5a77b8adb19f"
      }
    },
    "owner": "ctn.ogr"
  }
}
